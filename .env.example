# ── Google AI (required for visual analysis) ──────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key_here

# ── Local dev only ────────────────────────────────────────────────────────────
PORT=4000

# ── Optional: custom Chrome path for local dev (Windows/Mac/Linux) ────────────
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── Upstash Redis  (required on Vercel) ───────────────────────────────────────
# Create free DB at https://console.upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ── Upstash QStash  (required on Vercel — handles background scan jobs) ───────
# Same console → QStash → Create → copy token + signing keys
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# ── Your deployed Vercel URL (required on Vercel) ─────────────────────────────
# e.g. https://qa-agent-self.vercel.app  (no trailing slash)
QSTASH_BASE_URL=https://your-app.vercel.app
